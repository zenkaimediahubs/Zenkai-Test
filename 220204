<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Zenkai · Manga sources</title><style>
:root{color-scheme:dark;font:16px system-ui,sans-serif;background:#101117;color:#f5f5f7}body{max-width:1100px;margin:auto;padding:18px}a{color:#b9a3ff}.panel{border:1px solid #40404b;border-radius:14px;padding:16px;margin:12px 0;background:#191921}input,select,button{font:inherit;border-radius:9px;padding:10px;background:#282835;border:1px solid #575764;color:inherit}button{cursor:pointer;margin:4px}button:hover{border-color:#c5b6ff}input{width:min(65%,430px)}#results button{display:block;text-align:left;width:100%;white-space:normal}.muted{color:#aaa}#pages img{display:block;max-width:100%;height:auto;margin:8px auto}#pages.double{display:grid;grid-template-columns:1fr 1fr;gap:4px}#pages.double img{width:100%;margin:0}.row{display:flex;align-items:center;gap:8px;flex-wrap:wrap}#alert{white-space:pre-wrap;color:#f6c6a8}#pages{max-width:950px;margin:auto}.small{font-size:13px}</style></head><body>
<p><a href="/">← Zenkai Media Hub</a></p><h1>Manga sources</h1><p class="muted">Tankoyomi-compatible English and French source adapters, adapted from Colosseum. Publicly reachable pages only. Results and image availability depend on each provider.</p>
<section class="panel"><div class="row"><label for="lang">Language</label><select id="lang"><option value="en">English</option><option value="fr">Français</option></select><label for="provider">Source</label><select id="provider"></select></div><div class="row"><input id="query" type="search" placeholder="Search for manga title"><button id="search">Search</button></div><p id="alert" role="status"></p></section>
<section class="panel" id="listing"><h2 id="heading">Find a manga</h2><div id="results"></div></section>
<section class="panel" id="reading" hidden><div class="row"><button id="back">← Chapters</button><label>Mode <select id="mode"><option value="strip">Vertical strip</option><option value="single">Single page</option><option value="double">Double page</option></select></label><button id="previous">Previous page</button><span id="count"></span><button id="next">Next page</button></div><div id="pages"></div></section>
<footer><p class="muted small">Parsers © 2026 Hemanth Ganneni, Colosseum · MIT licence. No paywall, authentication, or anti-bot bypass. Individual sources control access to their own pages.</p></footer>
<script>
const $=s=>document.querySelector(s), ap='/api/tankoyomi';let sources=[],results=[],currentPages=[],page=0;
const names={'weebcentral':'WeebCentral','sushiscan-fr':'Sushiscan.fr','lelscan-vf':'Lelscan-VF','lelmanga':'Lelmanga','mangamoins':'MangaMoins'};
function status(m){$('#alert').textContent=m||''}function reset(){ $('#results').replaceChildren(); $('#reading').hidden=true; $('#listing').hidden=false; }
function sourceSelect(){let lang=$('#lang').value;$('#provider').replaceChildren(...sources.filter(s=>s.language===lang).map(s=>new Option(names[s.id]||s.id,s.id))); reset();}
async function api(params){const r=await fetch(ap+'?'+new URLSearchParams(params));const d=await r.json();if(!r.ok)throw Error(d.error||'Source failed');return d.items||[]}
function itemButton(title,fn){let b=document.createElement('button');b.textContent=title;b.onclick=fn;$('#results').append(b)}
async function run(fn){try{status('Loading…');await fn();status('')}catch(e){status(e.message+' — Try another source or return later.')}}
async function search(){reset();const q=$('#query').value.trim();if(!q)return status('Enter a manga title');await run(async()=>{results=await api({action:'search',provider:$('#provider').value,q});$('#heading').textContent='Search results ('+results.length+')';if(!results.length)status('No results at this source');results.forEach(s=>itemButton(s.title||s.id,()=>chapters(s)));})}
async function chapters(series){reset();await run(async()=>{const items=await api({action:'chapters',provider:$('#provider').value,url:series.url,id:series.id});$('#heading').textContent=(series.title||'Manga')+' — chapters ('+items.length+')';if(!items.length)status('No chapters returned');items.forEach(c=>itemButton(c.title||c.label||'Chapter '+(c.number??c.id),()=>pages(c)));})}
async function pages(chapter){await run(async()=>{currentPages=await api({action:'pages',provider:$('#provider').value,url:chapter.url,id:chapter.id});currentPages=currentPages.filter(p=>p.url&&/^https:\/\//i.test(p.url));if(!currentPages.length)return status('No readable pages returned by the source');page=0;$('#reading').hidden=false;$('#listing').hidden=true;showPages();$('#reading').scrollIntoView();})}
function showPages(){let el=$('#pages');el.replaceChildren();const mode=$('#mode').value;el.className=mode==='double'?'double':'';const list=mode==='strip'?currentPages:currentPages.slice(page,page+(mode==='double'?2:1));list.forEach((p,i)=>{let img=document.createElement('img');img.loading=i<2?'eager':'lazy';img.referrerPolicy='no-referrer';img.alt='Page '+(mode==='strip'?i+1:page+i+1);img.src=p.url;img.onerror=()=>{img.alt='Page unavailable from this source';};el.append(img)});$('#count').textContent=mode==='strip'?currentPages.length+' pages':`Page ${page+1} of ${currentPages.length}`;}
$('#back').onclick=()=>{$('#reading').hidden=true;$('#listing').hidden=false};$('#previous').onclick=()=>{page=Math.max(0,page-($('#mode').value==='double'?2:1));showPages()};$('#next').onclick=()=>{page=Math.min(currentPages.length-1,page+($('#mode').value==='double'?2:1));showPages()};$('#mode').onchange=showPages;$('#lang').onchange=sourceSelect;$('#search').onclick=search;$('#query').addEventListener('keydown',e=>{if(e.key==='Enter')search()});
const q=new URLSearchParams(location.search);if(q.get('title'))$('#query').value=q.get('title');
fetch(ap+'?action=providers').then(r=>r.json()).then(d=>{sources=d.providers||[];$('#lang').value=q.get('lang')==='fr'?'fr':'en';sourceSelect();}).catch(e=>status('Cannot load source list: '+e.message));
</script></body></html>